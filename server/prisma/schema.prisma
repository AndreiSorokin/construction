generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────── Справочники / орг.структура ────────────────────────────

enum Role {
  ADMIN
  REQUESTER
  APPROVER
  WAREHOUSE
  SUPPLY
}

enum RequestType {
  TMC // ТМЦ
  TRANSPORT // транспорт
  QUARRY // карьер
  FUNDS // денежные средства
  FUEL // ГСМ
  TRAVEL // командировка
  PRODUCTION // производство
}

enum Priority {
  URGENT // Срочно
  HIGH // Высокий
  NORMAL // Обычный
  LOW // Низкий
}

enum RequestStatus {
  APPROVAL // на согласовании
  SUPPLY // в снабжении
  FULFILLED // выполнено снабжением
  DONE // подтверждено заявителем
  REJECTED // отклонено
}

enum SupplyStage {
  NEW
  INWORK
  ORDERED
  ARRIVED
}

enum OrderStatus {
  APPROVAL
  APPROVED
  REJECTED
}

enum WorkKind {
  STROY // строительные
  ELEKTRO // электромонтажные
}

enum StockStatus {
  IN // есть на складе
  OUT // нет
}

enum DecisionAction {
  CREATED
  APPROVED
  REJECTED
  STOCK
  FULFILLED
  CONFIRMED
  RETURNED
  EDITED // правка состава/полей
  RESUBMITTED // отправлено повторно после доработки
  WITHDRAWN // отозвано автором
  CONSOLIDATED // включено в сводную
  UNCONSOLIDATED // сводная расформирована
}

// ──────────────────────────── Организации (мультитенантность) ────────────────────────────

// одна организация = один клиент SaaS, свой поддомен {slug}.interstil.kz, полностью
// изолированная оргструктура/заявки/наряды/справочники/настройки
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  departments      Department[]
  users            User[]
  objects          ObjectSite[]
  supplyChainSteps SupplyChainStep[]
  orderChainSteps  OrderChainStep[]
  catalogItems     CatalogItem[]
  workCatalogs     WorkCatalog[]
  ips              Ip[]
  vehicles         Vehicle[]
  requests         Request[]
  orders           Order[]
  appSetting       AppSetting?
  adminMessages    AdminMessage[]
  anonMessages     AnonMessage[]
  announcements    Announcement[]
  calendarEvents   CalendarEvent[]
  counters         Counter[]
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())

  users            User[]
  objects          ObjectSite[]
  supplyChainSteps SupplyChainStep[]
  orderChainSteps  OrderChainStep[]
  requests         Request[]
  orders           Order[]

  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  login          String
  email          String?      @unique
  passwordHash   String
  name           String
  role           Role         @default(REQUESTER)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isLead         Boolean      @default(false) // старший снабжения — может назначать исполнителей
  ordersAccess   Boolean      @default(false) // доступ к разделу «Наряды»
  canPrice       Boolean      @default(false) // право менять ЦЕНЫ в нарядах (кол-во может любой согласующий)
  theme          String       @default("light") // light | dark
  avatarKey      String? // ключ фото профиля в S3
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  objectAccess    ObjectAccess[]
  refreshTokens   RefreshToken[]
  notes           Note[]
  createdRequests Request[]      @relation("RequestRequester")
  createdOrders   Order[]        @relation("OrderRequester")

  @@unique([organizationId, login])
  @@index([role])
  @@index([organizationId])
}

model ObjectSite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String       @default("stone")
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  access   ObjectAccess[]
  requests Request[]
  orders   Order[]

  @@index([organizationId])
}

// доступ пользователей к объектам (многие-ко-многим)
model ObjectAccess {
  objectId String
  userId   String
  object   ObjectSite @relation(fields: [objectId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([objectId, userId])
}

// шаг маршрута согласования заявок (по отделу и типу)
model SupplyChainStep {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  type           RequestType
  order          Int
  approverId     String
  label          String

  @@index([departmentId, type, order])
  @@index([organizationId])
}

// шаг маршрута согласования нарядов (только строительный отдел; единый маршрут)
model OrderChainStep {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  order          Int
  approverId     String
  label          String

  @@index([departmentId, order])
  @@index([organizationId])
}

// номенклатура снабжения (необязательная подсказка при создании заявки)
model CatalogItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  unit           String
  category       String

  @@index([organizationId])
}

// списки работ для нарядов
model WorkCatalog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           WorkKind
  items          WorkItem[]

  @@index([organizationId])
}

model WorkItem {
  id        String      @id @default(cuid())
  catalogId String
  catalog   WorkCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  name      String
  unit      String
  price     Decimal     @db.Decimal(14, 2)

  @@index([catalogId])
}

// ИП-подрядчики (на кого закрываются наряды)
model Ip {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  bin            String?
  vat            Boolean      @default(true) // плательщик НДС / общеустановленный режим
  orders         Order[]

  @@index([organizationId])
}

// справочник техники — подсказки в заявках «Транспорт»/«Топливо»
model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ──────────────────────────── Заявки (снабжение) ────────────────────────────

model Request {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number             String // ТМЦ-0001 и т.п. — уникально в рамках организации
  type               RequestType
  departmentId       String
  department         Department    @relation(fields: [departmentId], references: [id])
  requesterId        String
  requester          User          @relation("RequestRequester", fields: [requesterId], references: [id])
  objectId           String?
  object             ObjectSite?   @relation(fields: [objectId], references: [id], onDelete: SetNull)
  priority           Priority      @default(NORMAL)
  note               String        @default("")
  due                DateTime?
  status             RequestStatus @default(APPROVAL)
  currentStageIndex  Int           @default(0)
  // снабжение
  assigneeId         String?
  supplyStage        SupplyStage   @default(NEW)
  postponed          Boolean       @default(false)
  spent              Decimal?      @db.Decimal(14, 2) // фактически потрачено (снабжение)
  // объединение заявок (сводные СВ-####)
  isConsolidated     Boolean       @default(false) // это сводная
  consolidatedIntoId String? // исходная входит в сводную (скрыта у автора, postponed)
  consolidatedInto   Request?      @relation("Consolidation", fields: [consolidatedIntoId], references: [id], onDelete: SetNull)
  consolidatedFrom   Request[]     @relation("Consolidation")
  wasConsolidated    String? // номер сводной, в составе которой закуплена (после fulfill)
  // динамические поля по типу заявки (vehicle, route, amount, purpose…)
  fields             Json          @default("{}")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items       RequestItem[]
  chainSteps  RequestApprovalStep[]
  events      RequestEvent[]
  supplyNotes SupplyNote[]
  attachments Attachment[]

  @@unique([organizationId, number])
  @@index([status])
  @@index([type])
  @@index([departmentId])
  @@index([organizationId])
}

model RequestItem {
  id           String       @id @default(cuid())
  requestId    String
  request      Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name         String
  unit         String
  qty          String       @default("") // храним как введено (может быть «≈ 30»)
  note         String       @default("")
  fulfilled    Boolean      @default(false)
  deliveredQty String       @default("") // «получено N» (снабженец)
  eta          DateTime? // ожидаемый срок поставки позиции
  srcRefs      Json? // для позиций СВОДНОЙ: [{requestId,itemId}] — откуда агрегировано
  stockStatus  StockStatus?
  stockById    String?
  stockByName  String?
  stockAt      DateTime?
}

// снапшот маршрута согласования на момент создания + решения
model RequestApprovalStep {
  id           String          @id @default(cuid())
  requestId    String
  request      Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order        Int
  approverId   String
  approverName String
  role         Role
  label        String
  decision     DecisionAction?
  decidedAt    DateTime?
  comment      String?

  @@index([requestId, order])
}

model RequestEvent {
  id        String         @id @default(cuid())
  requestId String
  request   Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action    DecisionAction
  byId      String
  byName    String
  stage     String?
  comment   String?
  at        DateTime       @default(now())

  @@index([requestId])
}

model SupplyNote {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  byId      String
  byName    String
  text      String
  at        DateTime @default(now())
}

// ──────────────────────────── Наряды ────────────────────────────

model Order {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number            String // Н-0001 — уникально в рамках организации
  departmentId      String
  department        Department   @relation(fields: [departmentId], references: [id])
  requesterId       String
  requester         User         @relation("OrderRequester", fields: [requesterId], references: [id])
  objectId          String?
  object            ObjectSite?  @relation(fields: [objectId], references: [id], onDelete: SetNull)
  ipId              String?
  ip                Ip?          @relation(fields: [ipId], references: [id], onDelete: SetNull)
  period            String // YYYY-MM
  catalogId         String?
  note              String       @default("")
  status            OrderStatus  @default(APPROVAL)
  currentStageIndex Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  lines       OrderLine[]
  chainSteps  OrderApprovalStep[]
  events      OrderEvent[]
  attachments Attachment[]

  @@unique([organizationId, number])
  @@index([status])
  @@index([period])
  @@index([departmentId])
  @@index([organizationId])
}

model OrderLine {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  workId  String?
  name    String
  unit    String
  price   Decimal @db.Decimal(14, 2)
  qty     String  @default("")
}

model OrderApprovalStep {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  order_       Int             @map("order_index")
  approverId   String
  approverName String
  role         Role
  label        String
  decision     DecisionAction?
  decidedAt    DateTime?
  comment      String?

  @@index([orderId, order_])
}

model OrderEvent {
  id      String         @id @default(cuid())
  orderId String
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action  DecisionAction
  byId    String
  byName  String
  stage   String?
  comment String?
  at      DateTime       @default(now())

  @@index([orderId])
}

// ──────────────────────────── Вложения (S3) ────────────────────────────

model Attachment {
  id               String   @id @default(cuid())
  requestId        String?
  request          Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromConsolidated String? // перенесено из сводной СВ-N при разъединении
  key              String // ключ объекта в S3
  filename         String
  mime             String
  size             Int
  byId             String
  byName           String
  createdAt        DateTime @default(now())

  @@index([requestId])
  @@index([orderId])
}

// ──────────────────────────── Личный блокнот ────────────────────────────

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ──────────────────────────── Нумерация ────────────────────────────

// последовательные номера документов (req:TMC, req:FUEL, order …)
model Counter {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Int          @default(0)

  @@id([organizationId, key])
}

// ──────────────────────────── Refresh-токены (ротация + защита от гонки) ────────────────────────────

// Каждый refresh-токен одноразовый и принадлежит «семье» (familyId = сессия устройства).
// При обновлении токен помечается rotatedAt и ссылается на преемника (replacedById).
// Повторное использование вне grace-окна → компрометация → отзыв всей семьи.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId     String // общая «семья» цепочки ротаций (одна сессия)
  tokenHash    String    @unique // bcrypt/sha256 от секрета токена
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  rotatedAt    DateTime? // когда токен был обменян
  replacedById String? // id выданного на замену токена
  revoked      Boolean   @default(false)
  userAgent    String?
  ip           String?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ──────────────────────────── Настройки приложения (одна строка id="app") ────────────────────────────

model AppSetting {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  urgentLimit    Int          @default(3) // «Срочно» в день; 0 = без лимита
  logoKey        String? // логотип компании в S3 (PNG с альфой / SVG)
  logoW          Int?
  logoH          Int?
  updatedAt      DateTime     @updatedAt
}

// ──────────────────────────── Связь (без сокетов: обычные списки) ────────────────────────────

// сообщения администратору — односторонний канал «сотрудник → админ»
model AdminMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromId         String
  fromName       String
  text           String
  createdAt      DateTime     @default(now())
  readAt         DateTime? // отметка «прочитано админом»

  @@index([createdAt])
  @@index([organizationId])
}

// анонимные сообщения руководству — автор НЕ сохраняется нигде
model AnonMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  text           String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  text           String
  byId           String
  byName         String
  pinned         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  reads AnnouncementRead[]

  @@index([organizationId])
}

model AnnouncementRead {
  announcementId String
  userId         String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  at             DateTime     @default(now())

  @@id([announcementId, userId])
}

// общий календарь событий
model CalendarEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           String // YYYY-MM-DD
  title          String
  byId           String
  byName         String
  createdAt      DateTime     @default(now())

  @@index([date])
  @@index([organizationId])
}

// черновики заявок: по одному на пользователя и тип
model Draft {
  userId    String
  type      RequestType
  payload   Json
  updatedAt DateTime    @updatedAt

  @@id([userId, type])
}
