generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MECHANIC
  FOREMAN
  SITE_MANAGER
  WORKSHOP_MANAGER
  DEPUTY_PRODUCTION_DIRECTOR
  DEPUTY_TRANSPORT_DIRECTOR
  SUPPLY_MANAGER
  SUPPLY
  TRANSPORT_SUPPLY
  PTO
  CHIEF_ENGINEER
  GARAGE_MANAGER
  WAREHOUSE_MANAGER
  STOREKEEPER
  ACCOUNTANT
  SECRETARY
  DIRECTOR
}

enum ObjectType {
  CONSTRUCTION_OBJECT
  INTERNAL_DEPARTMENT
  WORKSHOP
}

enum ObjectDirection {
  TRANSPORT
  CONSTRUCTION
  PRODUCTION
}

enum SupplyRequestStatus {
  CREATED
  PENDING_PTO
  PENDING_CHIEF_ENGINEER
  PENDING_DEPUTY_PRODUCTION_DIRECTOR
  PENDING_DEPUTY_TRANSPORT_DIRECTOR
  PENDING_SUPPLY_MANAGER
  PENDING_SUPPLY_MANAGER_REVIEW
  PENDING_SUPPLY
  PENDING_TRANSPORT_SUPPLY
  PENDING_DIRECTOR
  PENDING_GARAGE_MANAGER
  PENDING_WAREHOUSE_MANAGER
  PENDING_STOREKEEPER
  PENDING_ACCOUNTANT
  PENDING_TRANSPORT_AUTHOR
  PENDING_WORKSHOP_MANAGER
  PENDING_PRODUCTION_AUTHOR
  PENDING_REQUEST_AUTHOR
  RETURNED_TO_SUPPLY
  REJECTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum SupplyRequestType {
  MATERIAL
  TRANSPORT
  MONEY
  PRODUCTION
  QUARRY
  EXPRESS_MATERIAL
  FUEL
  BUSINESS_TRIP
  APPEAL
}

enum MoneyRequestPaymentType {
  CASH
  NON_CASH
}

enum ObjectLimitType {
  MATERIAL
  TRANSPORT
  MONEY
}

enum ApprovalAction {
  CREATED
  APPROVED
  REJECTED
  RETURNED
  SENT_TO_PTO
  SENT_TO_CHIEF_ENGINEER
  SENT_TO_SUPPLY_MANAGER
  SENT_TO_SUPPLY
  SENT_TO_TRANSPORT_SUPPLY
  SENT_TO_GARAGE_MANAGER
  SENT_TO_WAREHOUSE_MANAGER
  SENT_TO_STOREKEEPER
  SENT_TO_ACCOUNTANT
  SENT_TO_WORKSHOP_MANAGER
  SENT_TO_AUTHOR
  ASSIGNED_TO_SUPPLY
  SENT_TO_DIRECTOR
  MARKED_IN_PROGRESS
  COMPLETED
  ARCHIVED
  COMMENTED
  PRICE_UPDATED
  REQUEST_ITEM_UPDATED
  REQUEST_ITEM_DELETED
}

enum PriceField {
  SUPPLIER_PURCHASE_PRICE
}

enum SupplyRequestItemFulfillmentStatus {
  PENDING
  COMPLETED
  SKIPPED
}

model User {
  id                          String                 @id @default(cuid())
  email                       String                 @unique
  passwordHash                String
  refreshTokenHash            String?
  name                        String
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  ownedObjects                ObjectEntity[]         @relation("ObjectOwner")
  objectAccesses              UserObjectAccess[]
  supplyRequests              SupplyRequest[]        @relation("SupplyRequestAuthor")
  assignedRequests            SupplyRequest[]        @relation("AssignedSupplyUser")
  assignedStorekeeperRequests SupplyRequest[]        @relation("AssignedStorekeeper")
  assignedWorkshopRequests    SupplyRequest[]        @relation("AssignedWorkshopManager")
  assignedByRequests          SupplyRequest[]        @relation("AssignedByUser")
  approvalActions             ApprovalHistory[]      @relation("ApprovalActor")
  priceChanges                RequestPriceHistory[]  @relation("PriceChangeActor")
  uploadedInvoices            SupplyRequestInvoice[] @relation("InvoiceUploader")
  uploadedAttachments         SupplyRequestAttachment[] @relation("AttachmentUploader")
  sentInvitations             Invitation[]           @relation("InvitationInviter")
}

model ObjectEntity {
  id             String             @id @default(cuid())
  name           String
  type           ObjectType
  direction      ObjectDirection     @default(CONSTRUCTION)
  ownerId        String
  owner          User               @relation("ObjectOwner", fields: [ownerId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  limits         ObjectLimit[]
  materials      ObjectMaterial[]
  userAccesses   UserObjectAccess[]
  supplyRequests SupplyRequest[]
  invitations    Invitation[]

  @@index([ownerId])
}

model ObjectLimit {
  id          String          @id @default(cuid())
  objectId    String
  type        ObjectLimitType
  limitAmount Decimal         @db.Decimal(18, 2)
  spentAmount Decimal         @default(0) @db.Decimal(18, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  object      ObjectEntity    @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, type])
  @@index([objectId])
}

model UserObjectAccess {
  id        String       @id @default(cuid())
  userId    String
  objectId  String
  role      UserRole
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  object    ObjectEntity @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([userId, objectId])
  @@index([objectId])
}

model Invitation {
  id         String       @id @default(cuid())
  email      String
  name       String
  tokenHash  String       @unique
  userRole   UserRole
  objectId   String
  inviterId  String
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  object     ObjectEntity @relation(fields: [objectId], references: [id], onDelete: Cascade)
  inviter    User         @relation("InvitationInviter", fields: [inviterId], references: [id])

  @@index([email])
  @@index([objectId])
  @@index([inviterId])
}

model ObjectMaterial {
  id              String       @id @default(cuid())
  objectId        String
  object          ObjectEntity @relation(fields: [objectId], references: [id], onDelete: Cascade)
  name            String
  type            String
  measurementUnit String
  estimatedPrice  Decimal      @db.Decimal(18, 2)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([objectId, name, measurementUnit])
  @@index([objectId])
}

model SupplyRequest {
  id                    String                 @id @default(cuid())
  requestNumber         String                 @unique
  type                  SupplyRequestType
  status                SupplyRequestStatus    @default(CREATED)
  objectId              String
  authorId              String
  assignedSupplyUserId  String?
  assignedStorekeeperId String?
  assignedWorkshopManagerId String?
  assignedById          String?
  assignedAt            DateTime?
  transportType         String?
  transportObjectName   String?
  transportDate         String?
  transportTime         String?
  purpose               String?
  amount                Decimal?               @db.Decimal(18, 2)
  paymentType           MoneyRequestPaymentType?
  paymentPurpose        String?
  object                ObjectEntity           @relation(fields: [objectId], references: [id], onDelete: Cascade)
  author                User                   @relation("SupplyRequestAuthor", fields: [authorId], references: [id])
  assignedSupplyUser    User?                  @relation("AssignedSupplyUser", fields: [assignedSupplyUserId], references: [id])
  assignedStorekeeper   User?                  @relation("AssignedStorekeeper", fields: [assignedStorekeeperId], references: [id])
  assignedWorkshopManager User?                @relation("AssignedWorkshopManager", fields: [assignedWorkshopManagerId], references: [id])
  assignedBy            User?                  @relation("AssignedByUser", fields: [assignedById], references: [id])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  items                 SupplyRequestItem[]
  invoices              SupplyRequestInvoice[]
  attachments           SupplyRequestAttachment[]
  approvalHistory       ApprovalHistory[]

  @@index([objectId])
  @@index([authorId])
  @@index([assignedSupplyUserId])
  @@index([assignedStorekeeperId])
  @@index([assignedWorkshopManagerId])
  @@index([assignedById])
  @@index([status])
  @@index([type])
}

model SupplyRequestItem {
  id                      String                             @id @default(cuid())
  requestId               String
  request                 SupplyRequest                      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  materialNameSnapshot    String
  materialTypeSnapshot    String
  measurementUnitSnapshot String
  estimatedPriceSnapshot  Decimal                            @db.Decimal(18, 2)
  quantity                Decimal                            @db.Decimal(18, 3)
  orderQuantity           Decimal                            @default(0) @db.Decimal(18, 3)
  stockQuantity           Decimal                            @default(0) @db.Decimal(18, 3)
  supplierPurchasePrice   Decimal?                           @db.Decimal(18, 2)
  cashPaidAmount          Decimal?                           @db.Decimal(18, 2)
  cashPaymentComment      String?
  ptoComment              String?
  chiefEngineerComment    String?
  supplyComment           String?
  supplyManagerComment    String?
  supplierComment         String?
  fulfillmentStatus       SupplyRequestItemFulfillmentStatus @default(PENDING)
  createdAt               DateTime                           @default(now())
  updatedAt               DateTime                           @updatedAt
  priceHistory            RequestPriceHistory[]

  @@index([requestId])
}

model SupplyRequestInvoice {
  id           String        @id @default(cuid())
  requestId    String
  uploadedById String
  originalName String
  storedName   String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime      @default(now())
  request      SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation("InvoiceUploader", fields: [uploadedById], references: [id])

  @@index([requestId])
  @@index([uploadedById])
}

model SupplyRequestAttachment {
  id           String        @id @default(cuid())
  requestId    String
  uploadedById String
  originalName String
  storedName   String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime      @default(now())
  request      SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([requestId])
  @@index([uploadedById])
}

model ApprovalHistory {
  id          String               @id @default(cuid())
  requestId   String
  actorId     String
  action      ApprovalAction
  fromStatus  SupplyRequestStatus?
  toStatus    SupplyRequestStatus?
  comment     String?
  changesJson Json?
  createdAt   DateTime             @default(now())
  request     SupplyRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor       User                 @relation("ApprovalActor", fields: [actorId], references: [id])

  @@index([requestId])
  @@index([actorId])
  @@index([createdAt])
}

model RequestPriceHistory {
  id            String            @id @default(cuid())
  requestItemId String
  actorId       String
  field         PriceField
  oldValue      Decimal?          @db.Decimal(18, 2)
  newValue      Decimal?          @db.Decimal(18, 2)
  createdAt     DateTime          @default(now())
  requestItem   SupplyRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  actor         User              @relation("PriceChangeActor", fields: [actorId], references: [id])

  @@index([requestItemId])
  @@index([actorId])
  @@index([createdAt])
}
