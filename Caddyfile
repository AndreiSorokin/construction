# On-Demand TLS: перед выпуском сертификата для нового {slug}.supplex.su Caddy спрашивает
# бэкенд interstroy — существует ли такая организация (см. OrganizationsController.tlsAsk).
# Обычный HTTP-01, без DNS-плагинов и без CF_API_TOKEN — только запись в DNS (Cloudflare) нужна,
# чтобы поддомен вообще резолвился.
{
	on_demand_tls {
		ask http://interstroy-server:3000/api/organizations/tls-ask
		interval 2m
		burst 5
	}
}

*.supplex.su {
	tls {
		on_demand
	}
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy interstroy-server:3000
	}
	handle {
		reverse_proxy interstroy-client:3000
	}
}
